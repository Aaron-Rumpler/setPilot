// Capabilities that depend on your Apple developer account. Change these to match it, then
// rebuild. Every target uses this file (it's the project's base configuration).
//
// App Groups: lets the iPhone and watch widgets read the apps' data. Free (personal team)
// accounts appear to be able to use them, but that isn't certain; if Xcode won't sign the
// iPhone or watch targets with them, set this to NO. Without them the apps work fully, and the
// widgets and complications just have nothing to show.
WIZ_APP_GROUPS = YES

// iCloud: syncs presets, custom scenes, CCT scales and bulb names between your Mac and iPhone
// (the watch gets them from the iPhone). Needs a paid developer account.
WIZ_ICLOUD = NO

// Your development team's ID, for every target at once (Xcode's Signing & Capabilities sets it per
// target). The Mac command-line tool needs it, with a development certificate rather than "Sign to
// Run Locally": its App Group is named after the team.
// DEVELOPMENT_TEAM = ABCDE12345

// Derived from the two above; no need to edit. Without App Groups, the widget extensions are
// copied next to the apps rather than into them, so they aren't installed.
WIZ_WIDGETS_EMBED_YES = $(CONTENTS_FOLDER_PATH)/PlugIns
WIZ_WIDGETS_EMBED_NO = Widgets-left-out
WIZ_WIDGETS_EMBED_PATH = $(WIZ_WIDGETS_EMBED_$(WIZ_APP_GROUPS))
WIZ_ENTITLEMENTS = Entitlements/groups-$(WIZ_APP_GROUPS)_icloud-$(WIZ_ICLOUD)
WIZ_FLAG_GROUPS_YES = WIZ_APP_GROUPS
WIZ_FLAG_ICLOUD_YES = WIZ_ICLOUD
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) $(WIZ_FLAG_GROUPS_$(WIZ_APP_GROUPS)) $(WIZ_FLAG_ICLOUD_$(WIZ_ICLOUD))

// Text for translation: Xcode gathers each target's strings into its Localizable.xcstrings (String
// Catalogs). English only for now.
SWIFT_EMIT_LOC_STRINGS = YES
LOCALIZATION_PREFERS_STRING_CATALOGS = YES
